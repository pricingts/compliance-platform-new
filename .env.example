# Database
DATABASE_URL=postgresql://user:password@host:port/compliance_new_db
# Optional: separate public URL for off-cluster migrations / scripts (Railway).
# DATABASE_PUBLIC_URL=postgresql://user:password@public-host:port/compliance_new_db

# Environment (dev/staging/production)
ENV=dev

# Logging
LOG_LEVEL=INFO

# Google Drive (for Streamlit Cloud, use st.secrets instead)
# GOOGLE_DRIVE_CREDENTIALS_PATH=path/to/credentials.json
# GOOGLE_SHEETS_CREDENTIALS_PATH=path/to/credentials.json

# Admin Configuration
# ADMIN_EMAILS=compliance@tradingsolutions.com,jsanchez@tradingsolutions.com
# ADMIN_DOMAINS=@tradingsolutions.com,@tradingsol.com

# ───────────── Compliance mailer (NEW in this release) ─────────────
# Feature flag. Keep OFF until validated in staging, then flip to true.
MAILER_ENABLED=false

# SMTP transport. For Gmail corporate, use an App Password (16 chars,
# generated at https://myaccount.google.com/apppasswords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USE_TLS=false           # false => SMTP_SSL (port 465); true => STARTTLS (port 587)
SMTP_USERNAME=compliance@tradingsolutions.com
SMTP_PASSWORD=                # put your Gmail App Password here
SMTP_FROM_ADDR=compliance@tradingsolutions.com
